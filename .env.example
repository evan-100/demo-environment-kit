# Copy this file to .env and fill in real values. .env is gitignored.

# HubSpot service key (Development > Keys > Service keys), created in the
# developer test account that holds the demo data. Sent as a Bearer token.
HUBSPOT_TOKEN=

# Optional: HubSpot user ID who owns all demo records. Default: the account's first user.
KIT_OWNER_ID=

# LLM API key for `kit generate` (from M2 on).
ANTHROPIC_API_KEY=
